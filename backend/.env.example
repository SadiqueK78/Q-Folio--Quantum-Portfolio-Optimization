# Copy to .env and adjust. No API keys are required — every data source is free.

# --- Data ---
PRICE_PROVIDER=yahoo
HISTORICAL_YEARS=10
DATA_DIR=data_cache

# --- Budget / currency ---
CURRENCY=INR
DEFAULT_BUDGET=100000.0

# --- Risk ---
RISK_FREE_RATE=0.06

# --- Allocation defaults (Section 11) ---
DEFAULT_MAX_WEIGHT=0.20
DEFAULT_MIN_HOLDINGS=5
DEFAULT_MAX_HOLDINGS=10

# --- Transaction cost ---
DEFAULT_TRANSACTION_COST_PCT=0.0010

# --- QUBO ---
QUBO_WEIGHT_STEP=0.05
QUBO_NUM_READS=200

# --- API ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- News (free RSS feeds, comma-separated) ---
RSS_FEEDS=https://feeds.reuters.com/reuters/businessNews,https://www.moneycontrol.com/rss/latestnews.xml,https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms
